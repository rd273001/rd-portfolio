# Server-only. Never expose these to the client.
# Create an API key and verify ravidubey.in at https://resend.com/domains

RESEND_API_KEY=
CONTACT_FROM_EMAIL=Portfolio <contact@ravidubey.in>

# Optional. Defaults to the verified mailto address in content/socials.ts
# CONTACT_TO_EMAIL=portfolio-owner@gmail.com

# Auth.js (Google allowlist). Server-only. Generate AUTH_SECRET with `npx auth secret`.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL_ALLOWLIST=

# Supabase feedback store. Server-only — never use NEXT_PUBLIC_ for these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=